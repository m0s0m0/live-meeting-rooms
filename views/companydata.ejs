	
    <%- include('base.ejs') %>
 <% if(typeof message !== 'undefined' && message && message.length > 0) { %>
                <div class="message"><%= message %></div>
            <% } %>
 	<style>
		body{
		background: linear-gradient(rgba(0,0,0,0.5),rgba(0,0,0,0.5)),url("/assets/img/wallpaper.jpg");
		background-size: cover;
		background-attachment: fixed;
		}
	</style>

	<body>
		<form action="/user/companydata" method="post">
