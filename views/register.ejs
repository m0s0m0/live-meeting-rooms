	<script type="text/javascript">

       var slideIndex = 0;
        function slideshow() {

          var i;
          var slides = document.getElementsByClassName("mySlides");
          for (i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";  
            }
            slideIndex++;
            if (slideIndex > slides.length)
          {slideIndex = 1}    
            slides[slideIndex-1].style.display = "block";    
            setTimeout(slideshow, 3000); 
        }

                
        function ValidateEmail(mail) 
        {
        if (/^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$/.test(registeremailinput.value))
            {
            return (true)
            }
          else{
            document.getElementById("msg2").innerHTML="Use valid email address!";
            document.getElementById("emailinput").style.borderBottomColor="#C21A09";
            return (false)
            }
        }

        function ValidatePass(pass) 
        {
        if (/^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-])/.test(registerpass.value))
            {
            return (true)
            }
          else{
            document.getElementById("msg3").innerHTML="Use valid password!";
            document.getElementById("passwordinput").style.borderBottomColor="#C21A09";
            alert("Password must contain atleast 1 Uppercase,1 Lowercase,special character and a numeric letter.")
            return (false)
            }
        }

        function ValidateName(name) 
        {
        if (/^[A-Za-z]+$/.test(fullname.value))
            {
            return (true)
            }
          else{
            document.getElementById("msg1").innerHTML="Use valid name!";
            document.getElementById("fullname").style.borderBottomColor="#C21A09";
            alert("Name must contain only alphabet characters.")
            return (false)
            }
        }
        function emptyname()
        {document.getElementById("msg1").innerHTML="Name cannot be empty!";
        document.getElementById("fullname").style.borderBottomColor="#C21A09";
        }

        function emptymail()
        {document.getElementById("msg2").innerHTML="Email cannot be empty!";
        document.getElementById("registeremailinput").style.borderBottomColor="#C21A09";}

        function emptypass()
        {document.getElementById("msg3").innerHTML="Password cannot be empty!";
        document.getElementById("registerpass").style.borderBottomColor="#C21A09";}

        function emptyrepass()
        {document.getElementById("msg4").innerHTML="Password cannot be empty!";
        document.getElementById("repeatpassword").style.borderBottomColor="#C21A09";}

         function register()
              {
                var fname=document.getElementById("fullname").value;
                var mail=document.getElementById("registeremailinput").value;
                var pass=document.getElementById("registerpass").value;
                var repass=document.getElementById("repeatpassword").value;
                
                    if(fname=="")
                    {
                    var n=emptyname();  
                    }
                    else if(mail=="")
                    {
                    var m=emptymail();  
                    }
                    else if(pass=="")
                    {
                    var p=emptypass();  
                    }

                    else if(repass=="")
                    {
                    var r=emptyrepass();  
                    }
                  
                    else
                    {
                      if(pass==repass)
                        {alert("access given");}
                      else
                        {document.getElementById("msg4").innerHTML="Password does not match!";
                        document.getElementById("repeatpassword").style.borderBottomColor="#C21A09";}
                    }
                }
		</script>

